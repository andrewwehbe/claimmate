# LLM provider: "mock" (default, offline, no keys needed) or "openai"
RCM_LLM_PROVIDER=mock

# Required only when RCM_LLM_PROVIDER=openai
OPENAI_API_KEY=
RCM_OPENAI_MODEL=gpt-4o

# HITL routing thresholds
RCM_CONFIDENCE_THRESHOLD=0.90
RCM_CLAIM_VALUE_THRESHOLD=5000

# Payer timely-filing window in days (production: per-payer contract table)
RCM_TIMELY_FILING_DAYS=90
